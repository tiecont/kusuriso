extends ../layout.pug

block content
	main.page-main.detail-main
		p.breadcrumb
			a(href="/") Thư viện thuốc
			span(aria-hidden="true") /
			span= medicine.category

		section.detail-header
			div.detail-heading
				p.eyebrow= medicine.category.toUpperCase()
				if medicine.is_demo
					p.demo-label Nội dung minh họa · Chưa kiểm duyệt
				div.detail-title-line
					h1= medicine.name
					button.favorite-toggle.detail-favorite(type="button", data-favorite-toggle, data-slug=medicine.slug, data-name=medicine.name, data-category=medicine.category, data-image=medicine.image_url || '', aria-label="Lưu " + medicine.name, aria-pressed="false", title="Lưu thuốc")
						span(aria-hidden="true") ☆
				if medicine.generic_name && medicine.generic_name !== medicine.name
					p.detail-generic Hoạt chất: #{medicine.generic_name}
				if medicine.brands.length
					p.detail-brands Tên thương mại thường gặp: #{medicine.brands.join(' · ')}
				p.detail-summary= medicine.summary
			div.detail-image-wrap
				img.detail-image(src=medicine.image_url || '/medicine-placeholder.svg', alt=medicine.image_url ? 'Hình ảnh của ' + medicine.name : '', width="640", height="400")

		aside.safety-banner(role="note")
			span.safety-icon(aria-hidden="true") !
			div
				strong Lưu ý quan trọng
				p Thông tin dưới đây mang tính tham khảo. Liều dùng và cách dùng phụ thuộc từng người, dạng thuốc và chỉ định của nhân viên y tế.

		section.detail-sections(aria-label="Thông tin thuốc")
			article.info-section
				span.section-index 01
				div
					h2 Thuốc này là gì?
					p= medicine.description
			article.info-section
				span.section-index 02
				div
					h2 Công dụng thường gặp
					p= medicine.uses
			article.info-section
				span.section-index 03
				div
					h2 Cách dùng
					p= medicine.directions
			article.info-section
				span.section-index 04
				div
					h2 Tác dụng không mong muốn
					p= medicine.side_effects
			article.info-section.warning-section
				span.section-index 05
				div
					h2 Thận trọng
					p= medicine.warnings

		p.detail-back
			a.button.button-secondary(href="/") ← Quay lại thư viện
