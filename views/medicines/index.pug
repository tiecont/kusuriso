extends ../layout.pug

block content
	main.page-main
		section.intro-band
			div.intro-copy
				p.eyebrow KUSURISO · THƯ VIỆN THUỐC
				h1 Hiểu thuốc trước khi dùng.
				p.intro-note Tra cứu công dụng, lưu ý và tác dụng không mong muốn của các hoạt chất thông dụng.
				form.search-form(method="get", action="/", role="search")
					label.visually-hidden(for="medicine-search") Tìm thuốc hoặc hoạt chất
					span.search-icon(aria-hidden="true")
					input#medicine-search(type="search", name="q", value=query, placeholder="Tên thuốc, hoạt chất hoặc tên thương mại...", autocomplete="off")
					button.button.button-primary(type="submit") Tìm kiếm
				p.intro-hint Ví dụ: paracetamol, acetaminophen, Panadol
			div.intro-visual
				img.intro-photo(src="/medicine-photo.jpg", alt="Các viên thuốc phổ thông không nhãn trên nền sáng", width="1200", height="800", fetchpriority="high")
				div.visual-caption
					span.caption-mark(aria-hidden="true")
					span Kiến thức rõ ràng, lưu ý an toàn

		section.library-section#thu-vien(aria-labelledby="library-heading")
			div.library-toolbar
				div.library-title
					p.eyebrow THƯ VIỆN THUỐC
					h2#library-heading #{query ? 'Kết quả tra cứu' : 'Khám phá thuốc'}
					p.result-count(data-result-count, aria-live="polite") #{medicines.length} mục thông tin
				form.filter-form(method="get", action="/")
					if query
						input(type="hidden", name="q", value=query)
					label.visually-hidden(for="category-filter") Lọc theo nhóm thuốc
					select#category-filter(name="category", data-category-filter)
						option(value="", selected=!selectedCategory) Tất cả nhóm
						each category in categories
							option(value=category, selected=selectedCategory === category)= category

			div.library-controls
				div.view-tabs(role="group", aria-label="Nội dung thư viện")
					button.view-tab.is-active(type="button", aria-pressed="true", data-library-filter="all") Tất cả
					button.view-tab(type="button", aria-pressed="false", data-library-filter="saved")
						span Đã lưu
						span.saved-count(data-saved-count) 0
				div.view-modes(role="group", aria-label="Kiểu hiển thị")
					button.icon-button.is-active(type="button", data-view-mode="grid", aria-label="Hiển thị dạng lưới", title="Dạng lưới", aria-pressed="true")
						span(aria-hidden="true") ▦
					button.icon-button(type="button", data-view-mode="list", aria-label="Hiển thị dạng danh sách", title="Dạng danh sách", aria-pressed="false")
						span(aria-hidden="true") ☷

			div.medicine-grid(data-medicine-grid)
				each medicine in medicines
					article.medicine-card(data-medicine-card, data-slug=medicine.slug)
						div.card-image-wrap
							a.card-image-link(href="/thuoc/" + medicine.slug, tabindex="-1", aria-hidden="true")
								img.card-image(src=medicine.image_url || '/medicine-placeholder.svg', alt="", width="640", height="400", loading="lazy")
							span.card-category= medicine.category
							button.favorite-toggle(type="button", data-favorite-toggle, data-slug=medicine.slug, data-name=medicine.name, data-category=medicine.category, data-image=medicine.image_url || '', aria-label="Lưu " + medicine.name, aria-pressed="false", title="Lưu thuốc")
								span(aria-hidden="true") ☆
						div.card-content
							a.card-content-link(href="/thuoc/" + medicine.slug)
								if medicine.is_demo
									span.demo-label Nội dung minh họa
								div.card-name-row
									h3= medicine.name
									span.card-arrow(aria-hidden="true") ↗
								if medicine.generic_name && medicine.generic_name !== medicine.name
									p.generic-name= medicine.generic_name
								p.card-summary= medicine.summary
								if medicine.brands.length
									p.brand-list Thường gặp: #{medicine.brands.join(' · ')}
								span.read-more Xem thông tin

			p.saved-status(data-saved-status, role="status", aria-live="polite", hidden)
				span(data-saved-status-text)
				button.text-action(type="button", data-retry-saved, hidden) Thử lại

			div.empty-state(data-no-results, hidden=medicines.length > 0)
				span.empty-icon(aria-hidden="true") ?
				h3 Chưa tìm thấy tên thuốc hoặc hoạt chất phù hợp.
				p Kiểm tra chính tả hoặc thử tên thương mại khác.
				if query || selectedCategory
					a.text-link(href="/") Xóa bộ lọc

			div.empty-state(data-no-saved, hidden)
				span.empty-icon(aria-hidden="true") ☆
				h3 Chưa có thuốc đã lưu
				p Các mục bạn đánh dấu sẽ xuất hiện ở đây.
			if page > 1 || hasNextPage
				nav.library-pagination(data-pagination, aria-label="Trang kết quả")
					if page > 1
						a.text-link(href='/?' + new URLSearchParams({q: query, category: selectedCategory, page: String(page - 1)})) ← Trang trước
					span Trang #{page}
					if hasNextPage
						a.text-link(href='/?' + new URLSearchParams({q: query, category: selectedCategory, page: String(page + 1)})) Trang sau →

		section.recent-section(data-recent-section, hidden, aria-labelledby="recent-heading")
			div.recent-heading
				div
					p.eyebrow LỊCH SỬ ĐỌC
					h2#recent-heading Vừa xem
				button.text-action(data-clear-history, type="button") Xóa lịch sử
			div.recent-list(data-recent-list)
